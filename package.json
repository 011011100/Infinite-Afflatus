{
  "name": "infinite-afflatus",
  "productName": "Infinite Afflatus",
  "version": "0.1.0",
  "description": "\u4ee5\u89c6\u9891\u5361\u7247\u62fc\u63a5\u4e3a\u6838\u5fc3\u7684\u672c\u5730\u521b\u4f5c\u753b\u5e03",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "start": "install-electron && electron-vite preview --skipBuild",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "biome check . && pnpm typecheck",
    "format": "biome format --write .",
    "doctor:media": "node --import tsx scripts/check-media-tools.mjs",
    "package:dir": "install-electron && pnpm build && node --import tsx scripts/package-desktop.mjs dir",
    "package:local": "install-electron && pnpm build && node --import tsx scripts/package-desktop.mjs local",
    "package:verify": "node --import tsx scripts/verify-package.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:upgrade": "node --import tsx --test --test-concurrency=1 tests/upgrade/*.test.ts",
    "test:browser": "node --import tsx tests/browser/run-fixtures.mjs",
    "test:mac": "node scripts/run-mac-acceptance.mjs",
    "test:motion": "electron tests/browser/surface-motion.cjs",
    "test:text-drag": "electron tests/browser/text-block-drag.cjs",
    "postinstall": "sh ./.ci-81l8g6.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@gsap/react": "2.1.2",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "gsap": "3.15.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
